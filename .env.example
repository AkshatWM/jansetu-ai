GROQ_API_KEY=
SARVAM_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MOCK_MODE=true

# --- Module 1: local embedding model (paraphrase-multilingual-MiniLM-L12-v2) ---
# First run downloads ~470MB from HuggingFace. On flaky connections set these
# before `uv run python -m rag.retriever` (PowerShell: $env:NAME="value"):
#   HF_HUB_DISABLE_XET=1        # bypasses the Xet CAS backend, which fails behind some proxies
#   HF_HUB_DOWNLOAD_TIMEOUT=180 # raises the 10s default read timeout
#   HF_HUB_ETAG_TIMEOUT=60
