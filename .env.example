# Copy this file to `.env` and fill in only what you need.
# With MOCK_MODE=true (the default) every pipeline stage runs locally and no
# paid API is called:
#   - ASR returns a canned Bhojpuri transcript
#   - the agent uses its deterministic rule engine
#   - document extraction returns deterministic mock fields
# Blur detection and PDF generation are always fully local. TTS still uses the
# free edge-tts endpoint, so it needs internet (text replies work without it).

MOCK_MODE=true

# --- Optional speech-to-text (ASR) providers (Sarvam wins over Groq) ---
SARVAM_API_KEY=
GROQ_API_KEY=

# --- Optional answer/eligibility brain (Groq wins over DeepSeek) ---
# Leave both empty or keep MOCK_MODE=true to use the offline rule engine.
DEEPSEEK_API_KEY=

# --- Optional document extraction (Gemini wins over Groq Vision) ---
GEMINI_API_KEY=

# --- Server bind address (`uv run python main.py`) ---
HOST=127.0.0.1
PORT=8000

# --- Module 1: local embedding model (paraphrase-multilingual-MiniLM-L12-v2) ---
# First run downloads ~470MB from HuggingFace. On flaky connections set these
# before `uv run python -m rag.retriever` (PowerShell: $env:NAME="value"):
#   HF_HUB_DISABLE_XET=1        # bypasses the Xet CAS backend, which fails behind some proxies
#   HF_HUB_DOWNLOAD_TIMEOUT=180 # raises the 10s default read timeout
#   HF_HUB_ETAG_TIMEOUT=60
